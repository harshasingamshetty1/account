DEPLOYER_PRIVATE_KEY=0xDEPLOYER_KEY
SIGNER_ONE_ADDRESS=0xLEDGED_HW_ADDRESS
PERMISSION_ADDRESS=0xPERMISSION_ADDRESS

# Signer Type Configuration
# SIGNER_TYPE: "eoa" or "hardware" (optional)
# - If not set, auto-detects: EOA if SIGNER_PRIVATE_KEY is set, otherwise hardware (Ledger)
# - If SIGNER_PRIVATE_KEY is set, defaults to "eoa"
# - Otherwise, defaults to "hardware" (Ledger)
# SIGNER_TYPE=hardware

# EOA Signer (required if SIGNER_TYPE=eoa)
# SIGNER_PRIVATE_KEY=0x...
